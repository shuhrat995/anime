{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  // Build scope only (rootDir=src). Test files are type-run by vitest directly and are
  // linted separately, so including them here would break `tsc` emit with rootDir set.
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
