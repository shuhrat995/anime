# Zenith backend — environment variables namunasi
# Lokal uchun .env fayliga nusxalang; Render uchun Dashboard → Environment da to'ldiring.

NODE_ENV=development            # production | development | test
PORT=3000
API_PREFIX=/api/v1

# Postgres (lokal Docker yoki portable). Bulutda Render'ning ichki connection string'i.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/anime_platform
LOG_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/anime_logs

# Redis 6.2+ (BullMQ talabi). Render Key Value connection string'ini bering.
REDIS_URL=redis://127.0.0.1:6379

# Kamida 64 belgi — generateValue yoki o'zingiz yarating
JWT_ACCESS_SECRET=changethis_changeit_at_least_64_characters_long_secret_value_x2
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=changethis_changeit_at_least_64_characters_long_secret_value_x3
JWT_REFRESH_TTL=30d

# Vergul bilan ajratilgan originlar ro'yxati (bo'sh = hammaga ruxsat, dev uchun)
# Masalan: https://sevimli-anime.netlify.app,http://localhost:3001
CORS_ORIGINS=

# Storage: lokal MinIO yoki bulutda S3-mos (R2/B2/AWS)
STORAGE_PROVIDER=minio          # minio | s3
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anime-media

S3_REGION=auto
S3_BUCKET=your-bucket
S3_ENDPOINT=                    # R2: https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_PACKAGE_SIZE_MB=2048
LOG_LEVEL=info
